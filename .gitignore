# Virtual environment
venv/

# Environment variables
.env

# Python cache
__pycache__/
*.pyc

# macOS
.DS_Store

# keep folder structure but ignore actual data
data/raw/*
data/processed/*
data/chunks/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/chunks/.gitkeep

# Publish only the synthetic demonstration knowledge base.
!data/raw/2026/
data/raw/2026/*
!data/raw/2026/Synthetic_Wealth_Management/
!data/raw/2026/Synthetic_Wealth_Management/*.txt

# Runtime agent state is local; deterministic seed data remains tracked.
data/runtime/*
!data/runtime/.gitkeep
